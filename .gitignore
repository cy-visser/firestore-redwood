# ==============================================================================
# Terraform Ignore Rules
# ==============================================================================

# Local .terraform directories
**/.terraform/*
.terraform/

# .tfstate files
*.tfstate
*.tfstate.*
*.tfstate.backup
*.tfplan
*.tfplan.*

# Crash log files
crash.log
crash.*.log

# Exclude sensitive tfvars if desired
*.auto.tfvars
*.auto.tfvars.json

# Ignore override files as they are usually used only locally
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Include lock file if you want to hold defaults, but ignore state locks
.terraform.tfstate.lock.info

# CLI configuration files
.terraformrc
terraform.rc


# ==============================================================================
# Python & Packaging Ignore Rules
# ==============================================================================

__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Distribution / packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
venv/
env/
ENV/
env.bak/
venv.bak/


# ==============================================================================
# OS & IDE Files
# ==============================================================================

.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~


# ==============================================================================
# Security & Credentials
# ==============================================================================

.credentials/
*.env
*.pem
*.key
*.p12
service_account.json
