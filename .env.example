# ==============================================================================
# Redwood Retail: Environment Configuration Template
# Copy this file to .env and configure values for your Google Cloud environment.
# ==============================================================================

# Google Cloud Platform Settings
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=europe-west4

# Firestore Enterprise Settings (Native Mode)
FIRESTORE_DATABASE_ID=redwood
FIRESTORE_COLLECTION=retail

# BigQuery Data Warehouse & BQML
BIGQUERY_DATASET=redwood_retail
BIGQUERY_CDC_TABLE=orders_cdc
BIGQUERY_HISTORICAL_VIEW=customer_historical_data
BIGQUERY_CHURN_MODEL=customer_churn_model

# Cloud Storage & pipeline identity
GCS_BUCKET_PREFIX=redwood-retail
# Named for the Dataflow job this pipeline used to be. Renaming it would
# destroy and recreate the service account and drop every IAM grant on it,
# so the value stays as it is.
PIPELINE_SERVICE_ACCOUNT=dataflow-redwood-sa
