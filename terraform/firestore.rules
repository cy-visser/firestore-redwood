rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Customer Profiles: Read-only for account owner
    match /customers/{customerId} {
      allow read: if request.auth != null && request.auth.uid == customerId;
      allow write: if false;
    }

    // Customer Sessions: Created by client upon login
    match /customer_sessions/{sessionId} {
      allow create: if request.auth != null 
                    && request.resource.data.customerId == request.auth.uid
                    && request.resource.data.agentProcessingStatus == "PENDING";
      allow read: if request.auth != null && resource.data.customerId == request.auth.uid;
      allow update, delete: if false;
    }

    // Loyalty Offers: Read by customer; update restricted to redemption
    match /loyalty_offers/{offerId} {
      allow read: if request.auth != null && resource.data.customerId == request.auth.uid;
      allow update: if request.auth != null
                    && resource.data.customerId == request.auth.uid
                    && resource.data.status == "ACTIVE"
                    && request.resource.data.status == "REDEEMED"
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'claimedAt', 'orderId']);
      allow create, delete: if false;
    }
  }
}
